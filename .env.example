# Copy this file to .env. Keep .env local; setup never writes these values to YAML.
INFERENCE_API_URL=http://host.crc.testing:11434
INFERENCE_API_TYPE=ollama
INFERENCE_PROVIDER=ollama
INFERENCE_API_TOKEN=ollama-local
INFERENCE_MODEL=deepseek-v4-flash:cloud
INFERENCE_MODEL_NAME="DeepSeek V4 Flash Cloud"
# Second model offered in the OpenClaw model picker (same provider).
INFERENCE_SECONDARY_MODEL=gpt-oss:120b-cloud
INFERENCE_SECONDARY_MODEL_NAME="GPT OSS 120B Cloud"

# Memorable defaults for the demonstration mailbox.
DEMO_MAIL_USER=demo
DEMO_MAIL_PASSWORD=demo
DEMO_MAIL_DOMAIN=demo.test
